    {
      "package": "ppt-master-skill-dsh",
      "kind": "github-releases",
      "mode": "snapshot",
      "source": "hugohe3/ppt-master",
      "asset": "ppt-master-skill-{tag}.zip",
      "assetSubtree": "ppt-master/skills/ppt-master",
      "upstream": {
        "tagPrefix": "v"
      },
      "pluginDir": "ppt-master-plugin-build",
      "expectedSkills": [
        "ppt-master"
      ],
      "manualSkills": [],
      "license": "MIT",
      "notes": "Upstream publishes one release asset per version, and its name carries that version (ppt-master-skill-v6.7.0.zip), so the declared asset uses a {tag} placeholder; the asset wraps the payload one level deeper - ppt-master/skills/ppt-master/ - which assetSubtree unwraps. The payload ships byte-for-byte, including SPONSORS.md and the attribution gate, so an update replaces skills/ppt-master/ wholesale: no recipe, no local edits."
    },
